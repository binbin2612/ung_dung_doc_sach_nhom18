<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Layout khi chưa đăng nhập -->
    <LinearLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_user"
            app:tint="@color/white"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="Chào mừng trở lại"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:startIconDrawable="@drawable/ic_user"
            app:startIconTint="@color/primary"
            app:hintEnabled="true"
            android:hint="Email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/AppEditTextStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/primary"
            app:startIconDrawable="@drawable/ic_user"
            app:startIconTint="@color/primary"
            android:hint="Mật khẩu">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/AppButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Đăng nhập"
            android:backgroundTint="@color/primary"
            android:textColor="@color/on_primary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gray"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Hoặc "
                android:textColor="@color/gray"
                android:textSize="12sp"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/gray"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogleLogin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Google"
                app:icon="@drawable/ic_google"
                app:iconTint="@color/white"
                android:textColor="@color/white"
                app:strokeColor="@color/gray"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFacebookLogin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Facebook"
                app:icon="@drawable/ic_facebook"
                app:iconTint="@color/white"
                android:textColor="@color/white"
                app:strokeColor="@color/gray"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPhoneLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đăng nhập bằng số điện thoại"
            android:textColor="@color/primary"/>

        <TextView
            android:id="@+id/txtRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Chưa có tài khoản? Đăng ký ngay"
            android:textColor="@color/primary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Layout khi đã đăng nhập (Profile) -->
    <ScrollView
        android:id="@+id/layoutUserInfo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="60dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="16dp"
                app:strokeWidth="2dp"
                app:strokeColor="@color/white"
                app:cardBackgroundColor="@color/surface">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_user"
                    android:scaleType="centerInside"
                    android:padding="24dp"
                    app:tint="@color/white"
                    android:contentDescription="Avatar"/>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chào mừng, User!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"/>

            <TextView
                android:id="@+id/tvUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textStyle="italic"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/surface_variant"
                android:layout_marginVertical="24dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubscription"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quản lý gói đăng ký"
                app:icon="@drawable/ic_favorite"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cài đặt hệ thống"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditDisplayName"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Đổi tên hiển thị"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <!-- Nút dành riêng cho Admin -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageBooks"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Quản lý kho sách"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_sort_by_size"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageUsers"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Quản lý người dùng"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatistics"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Thống kê hệ thống"
                android:visibility="gone"
                app:icon="@drawable/ic_statistics"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPaymentSettings"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Cấu hình QR Thanh toán"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_camera"
                app:iconTint="@color/white"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/AppButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Đăng xuất"
                app:icon="@android:drawable/ic_lock_power_off"
                app:iconTint="@color/white"
                android:backgroundTint="@color/error"
                android:textColor="@color/white"/>

        </LinearLayout>
    </ScrollView>

    <!--văn bản hện thị versonf-->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2.1.0"
        android:textSize="12sp"
        android:textColor="@color/gray"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp" />
    \

    <!-- Nút quay về (Đưa xuống cuối để nằm trên cùng) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBack"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_home"
        app:iconTint="@color/white"
        android:backgroundTint="@color/surface"
        android:visibility="visible"
        android:elevation="8dp" />

</RelativeLayout>
